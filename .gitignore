# ============================================================
# you_in_the_loop — .gitignore
# 개인 데이터와 런타임 파일을 Git에서 제외합니다.
# ============================================================

# ── 개인 자아 데이터 (절대 커밋 금지) ──
01_origin/self_state/core/iframe/
01_origin/self_state/core/identity_delta/
01_origin/self_state/core/somatic_encoded.yaml
01_origin/self_state/roles/
01_origin/self_state/calibration/probes.yaml
01_origin/self_state/cloud_memory/
01_origin/self_state/session_log/
01_origin/self_state/archive/
01_origin/identity.md
01_origin/mission.md

# ── TSO 의중 / 프로젝트 현황 ──
tasks/tso_intent.yaml
tasks/org_health_snapshot.yaml
tasks/worker_status.yaml

# ── 런타임 로그 / 상태 파일 ──
context_logs/
permission_queue/*.json
ar_signal_queue/sig_*.yaml
ar_signal_queue/fyi_*.yaml
ar_signal_queue/escalation_*.yaml
dispatch_inbox/disp_*.yaml
worker_status.json
*.tmp

# ── 자율 개선 로그 (개인 운영 데이터) ──
tasks/infra/autonomous_improvement/deficiency_log.yaml
tasks/standing_tasks/*/last_run

# ── 유료 콘텐츠 (Gumroad 판매용, 공개 금지) ──
SETUP_GUIDE.md
SETUP_GUIDE_*.md

# ── 민감 정보 ──
.env
*.env.local
scripts/config.local.sh

# ── macOS ──
.DS_Store

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── Node ──
node_modules/
